# ── Base de datos MySQL ───────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_NAME=cinemax
DB_USER=root
DB_PASSWORD=tu_password

# Para conexiones remotas con SSL (ej. Aiven):
# DB_SSL_CA=/ruta/al/ca.pem
# DB_SSL_DISABLED=false

# ── TMDB API ──────────────────────────────────────────────────────────────────
# Genera tu token en: https://www.themoviedb.org/settings/api
TMDB_BEARER_TOKEN=eyJhbGci...
# O usando API key v3:
# TMDB_API_KEY=tu_api_key

# ── JWT (para la API FastAPI) ─────────────────────────────────────────────────
JWT_SECRET=cambia_esto_en_produccion
JWT_EXPIRE_MINUTES=60

# ── URL base de la API (para estados Reflex que llaman a la API) ──────────────
API_BASE_URL=http://localhost:8000
